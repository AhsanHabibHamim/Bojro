APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://bojro:bojro@localhost:5432/bojro
REDIS_URL=redis://localhost:6379/0
APP_SECRET_KEY=local-only-change-me-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
READINESS_TIMEOUT_SECONDS=2.0

# Optional. Both values are required to create or update the single seeded admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
