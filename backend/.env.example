APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
# Staging and production both reject debug, mocks, E2E/reset fixtures, public
# default secrets/keyrings, insecure origins, public docs, and missing workers.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
DATABASE_URL=postgresql+asyncpg://bojro:bojro@localhost:5432/bojro
REDIS_URL=redis://localhost:6379/0
APP_SECRET_KEY=local-only-change-me-at-least-32-characters
# Use four distinct, randomly generated 32+ character secrets outside local development.
JWT_SECRET_KEY=replace-with-a-distinct-strong-jwt-secret-32-chars-minimum
ADMIN_JWT_SECRET_KEY=replace-with-a-distinct-strong-admin-jwt-secret-32-chars-minimum
GUEST_IDENTITY_SECRET=replace-with-a-distinct-strong-guest-secret-32-chars-minimum
QUOTE_TOKEN_SECRET=replace-with-a-distinct-strong-quote-secret-32-chars-minimum
OTP_HMAC_SECRET=replace-with-a-distinct-strong-otp-hmac-secret-32-chars-minimum
JWT_ISSUER=bojro-api
JWT_AUDIENCE=bojro-storefront
ADMIN_JWT_AUDIENCE=bojro-admin
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ADMIN_ACCESS_TOKEN_MINUTES=15
ADMIN_REFRESH_ABSOLUTE_HOURS=8
ADMIN_REFRESH_IDLE_MINUTES=30
# URL-safe base64 encoding of exactly 32 random bytes. Never reuse a JWT/app secret.
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
# Preferred rotation-safe form. Keep retiring keys until all credentials are re-encrypted.
ADMIN_TOTP_ACTIVE_KEY_ID=v1
ADMIN_TOTP_KEYRING={"v1":"replace-with-url-safe-base64-32-byte-key"}
ADMIN_TOTP_REQUIRED=false
ADMIN_REFRESH_SESSION_LIMIT=60
ADMIN_REFRESH_IP_LIMIT=120
GUEST_IDENTITY_DAYS=30
QUOTE_TOKEN_MINUTES=5
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PREFIX=bojro
# OTP uses SMS_PROVIDER exclusively. Setting OTP_PROVIDER or OTP_EXTERNAL_* is rejected.
OTP_MOCK_CODE=123456
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Phase 7 engagement encryption and keyed lookups. JSON is key-id -> URL-safe base64 AES-256 key.
ENGAGEMENT_PII_KEYRING={"replace-key-id":"REPLACE_WITH_URLSAFE_BASE64_32_RANDOM_BYTES"}
ENGAGEMENT_PII_ACTIVE_KEY_ID=replace-key-id
# Rotation: add the new key, switch the active ID, and retain old lookup keys for at least
# ASSISTANT_RETENTION_DAYS/notification retention. Retain unsubscribe verification keys while
# any issued unsubscribe link must remain valid. New writes always use the active IDs.
ENGAGEMENT_LOOKUP_HMAC_KEYRING={"v1":"replace-with-32-plus-random-characters"}
ENGAGEMENT_LOOKUP_HMAC_ACTIVE_KEY_ID=v1
UNSUBSCRIBE_SIGNING_KEYRING={"v1":"replace-with-a-distinct-32-plus-random-secret"}
UNSUBSCRIBE_SIGNING_ACTIVE_KEY_ID=v1
CONSENT_POLICY_VERSION=2026-11-07-v1

# Email: disabled, mock (non-production only), smtp, or resend.
EMAIL_PROVIDER=disabled
EMAIL_FROM=Bojro <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
RESEND_API_KEY=

# SMS: disabled, mock (non-production only), or documentation-verified external HTTPS.
SMS_PROVIDER=disabled
SMS_ENDPOINT=
SMS_API_KEY=
SMS_CONFIGURED=false
SMS_DOCUMENTATION_VERIFIED=false
SMS_PROVIDER_NAME=
SMS_DOCUMENTATION_URL=
SMS_DOCUMENTATION_VERSION=
SMS_SUPPORTS_IDEMPOTENCY=false
SMS_IDEMPOTENCY_HEADER=Idempotency-Key
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_CONTENT_RETENTION_DAYS=30
NOTIFICATION_ATTEMPT_RETENTION_DAYS=180
ENGAGEMENT_TEST_RECIPIENT_ALIASES={}

# Server-side Meta CAPI only. Browser IDs are safe SiteSetting values.
META_CAPI_MODE=disabled
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# OpenAI-compatible mode requires explicit legal and zero-retention approval.
ASSISTANT_PROVIDER=disabled
ASSISTANT_ENDPOINT=https://api.openai.com/v1/chat/completions
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4.1-mini
ASSISTANT_ZERO_RETENTION_APPROVED=false
ASSISTANT_DPA_APPROVED=false
ASSISTANT_PUBLIC_ENABLED=false
NEWSLETTER_ENABLED=true
WHATSAPP_ENABLED=false
WHATSAPP_PHONE=+8801700000000
PHASE7_E2E_ENABLED=false
PHASE7_E2E_RESET_TOKEN=
CHECKOUT_QUOTE_IDENTITY_LIMIT=10
CHECKOUT_QUOTE_IP_LIMIT=30
CHECKOUT_QUOTE_PHONE_LIMIT=5
CHECKOUT_ORDER_IDENTITY_LIMIT=10
CHECKOUT_ORDER_IP_LIMIT=30
CHECKOUT_ORDER_PHONE_LIMIT=10
CHECKOUT_RATE_WINDOW_SECONDS=900
TRACKING_RATE_LIMIT=10
TRACKING_RATE_WINDOW_SECONDS=600
ACCOUNT_MUTATION_USER_LIMIT=60
ACCOUNT_MUTATION_IP_LIMIT=120
ACCOUNT_SENSITIVE_USER_LIMIT=20
ACCOUNT_SENSITIVE_IP_LIMIT=60
ACCOUNT_WISHLIST_USER_LIMIT=180
ACCOUNT_WISHLIST_IP_LIMIT=300
ACCOUNT_RATE_WINDOW_SECONDS=900
# Development/test only. Production requires STORAGE_PROVIDER=cloudinary and all credentials.
STORAGE_PROVIDER=mock
STORAGE_MOCK_SECRET=replace-with-a-distinct-storage-mock-secret-32-chars-minimum
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REVIEW_UPLOAD_SIGNATURE_SECONDS=300
REVIEW_UPLOAD_CLEANUP_HOURS=24
MEDIA_UPLOAD_SIGNATURE_SECONDS=300
MEDIA_UPLOAD_CLEANUP_HOURS=24
# Phase 6 public callback origins and documentation-gated provider modes.
PUBLIC_API_BASE_URL=https://api.bojro.test
PUBLIC_STOREFRONT_BASE_URL=https://storefront.bojro.test
BKASH_MODE=disabled
BKASH_CONFIGURED=false
BKASH_DOCUMENTATION_VERIFIED=false
NAGAD_MODE=disabled
NAGAD_CONFIGURED=false
NAGAD_DOCUMENTATION_VERIFIED=false
SSLCOMMERZ_MODE=disabled
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
PATHAO_MODE=disabled
PATHAO_CONFIGURED=false
PATHAO_DOCUMENTATION_VERIFIED=false
STEADFAST_MODE=disabled
STEADFAST_CONFIGURED=false
STEADFAST_DOCUMENTATION_VERIFIED=false
REDX_MODE=disabled
REDX_CONFIGURED=false
REDX_DOCUMENTATION_VERIFIED=false
PROVIDER_MOCK_SIGNING_SECRET=development-provider-mock-secret-change-me-32-characters
PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PROVIDER_READ_TIMEOUT_SECONDS=10
PROVIDER_WRITE_TIMEOUT_SECONDS=10
PROVIDER_POOL_TIMEOUT_SECONDS=3
PROVIDER_RESPONSE_MAX_BYTES=524288
WEBHOOK_BODY_MAX_BYTES=262144
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_IP_RATE_LIMIT=120
WEBHOOK_RATE_WINDOW_SECONDS=60
ONLINE_ORDER_TTL_MINUTES=30
PROVIDER_RECONCILE_INTERVAL_SECONDS=120
PROVIDER_RECONCILE_MAX_ATTEMPTS=24
# Optional test/development-only bearer token for POST /api/v1/e2e/phase6/reset.
# PHASE6_E2E_RESET_TOKEN=replace-with-a-local-ci-only-token
# Required HTTPS frontend revalidation receiver in staging/production.
REVALIDATION_URL=
REVALIDATION_SECRET=
REVALIDATION_TIMEOUT_SECONDS=5
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=12
PDF_FONT_PATH=/app/app/assets/NotoSansBengali-Regular.ttf
WORKER_HEARTBEAT_KEY=bojro:worker:heartbeat
WORKER_HEARTBEAT_MAX_AGE_SECONDS=180
WORKER_HEARTBEAT_REQUIRED=false
RETENTION_CLEANUP_BATCH_SIZE=500
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
TRUSTED_PROXY_CIDRS=[]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
READINESS_TIMEOUT_SECONDS=2.0
READINESS_DIAGNOSTICS_TOKEN=

# Optional. Both values are required to create the single admin when absent.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# One-shot operator action. Existing admin passwords are otherwise never rewritten by seed.
SEED_ADMIN_FORCE_PASSWORD_ROTATION=false
# Demo seed is refused unless APP_ENV is exactly development or test. SEED_ADMIN_*
# is forbidden in staging/production; use the explicit admin bootstrap command.
# Production-safe bootstrap without demo catalog/orders/content:
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FORCE_PASSWORD_ROTATION=false
# Commands:
#   python -m scripts.bootstrap_admin
#   python -m scripts.preflight
#   python -m scripts.retention_cleanup
#   python -m scripts.postdeploy_verify
#   python -m scripts.restore_verify
# Deploy worker entrypoint: arq app.workers.review_photos.WorkerSettings

# Operator-only verification inputs; these are not application runtime settings.
POSTDEPLOY_BASE_URL=
POSTDEPLOY_STOREFRONT_ORIGIN=
POSTDEPLOY_ENVIRONMENT=
POSTDEPLOY_REQUEST_TIMEOUT_SECONDS=5
POSTDEPLOY_TOTAL_TIMEOUT_SECONDS=30
RESTORE_DATABASE_URL=
RESTORE_VERIFY_TIMEOUT_SECONDS=60
RESTORE_EXPECTED_COUNTS_JSON={}
