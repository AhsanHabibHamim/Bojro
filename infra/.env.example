# Local development only. Staging/production use platform-scoped secrets and docs/DEPLOYMENT.md.
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

POSTGRES_DB=bojro
POSTGRES_USER=bojro
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
TRUSTED_PROXY_CIDRS=[]
READINESS_DIAGNOSTICS_TOKEN=local-readiness-diagnostics-token-32-characters
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_STOREFRONT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ERROR_REPORTING_ENDPOINT=
ERROR_REPORTING_ENDPOINT=

APP_SECRET_KEY=local-only-change-me-at-least-32-characters
JWT_SECRET_KEY=local-jwt-secret-change-me-at-least-32-characters
ADMIN_JWT_SECRET_KEY=local-admin-jwt-secret-change-me-at-least-32-characters
GUEST_IDENTITY_SECRET=local-guest-secret-change-me-at-least-32-characters
QUOTE_TOKEN_SECRET=local-quote-secret-change-me-at-least-32-characters
OTP_HMAC_SECRET=local-otp-secret-change-me-at-least-32-characters
OTP_MOCK_CODE=123456
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ADMIN_TOTP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ADMIN_TOTP_ACTIVE_KEY_ID=v1
ADMIN_TOTP_KEYRING={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
ADMIN_TOTP_REQUIRED=false

STORAGE_PROVIDER=mock
STORAGE_MOCK_SECRET=local-storage-mock-secret-change-me-32-characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External payment/courier providers default disabled. Explicit E2E commands set every mode to mock.
COURIER_PROVIDER=manual
BKASH_MODE=disabled
BKASH_CONFIGURED=false
BKASH_DOCUMENTATION_VERIFIED=false
NAGAD_MODE=disabled
NAGAD_CONFIGURED=false
NAGAD_DOCUMENTATION_VERIFIED=false
SSLCOMMERZ_MODE=disabled
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
PATHAO_MODE=disabled
PATHAO_CONFIGURED=false
PATHAO_DOCUMENTATION_VERIFIED=false
STEADFAST_MODE=disabled
STEADFAST_CONFIGURED=false
STEADFAST_DOCUMENTATION_VERIFIED=false
REDX_MODE=disabled
REDX_CONFIGURED=false
REDX_DOCUMENTATION_VERIFIED=false
PROVIDER_MOCK_SIGNING_SECRET=local-provider-mock-signing-secret-32-characters

ENGAGEMENT_PII_KEYRING={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
ENGAGEMENT_PII_ACTIVE_KEY_ID=v1
ENGAGEMENT_LOOKUP_HMAC_KEYRING={"v1":"local-engagement-lookup-hmac-key-32-characters"}
ENGAGEMENT_LOOKUP_HMAC_ACTIVE_KEY_ID=v1
UNSUBSCRIBE_SIGNING_KEYRING={"v1":"local-unsubscribe-signing-key-32-characters"}
UNSUBSCRIBE_SIGNING_ACTIVE_KEY_ID=v1
CONSENT_POLICY_VERSION=2026-11-07-v1

EMAIL_PROVIDER=mock
EMAIL_FROM=Bojro <no-reply@bojro.test>
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
RESEND_API_KEY=
SMS_PROVIDER=mock
SMS_ENDPOINT=
SMS_API_KEY=
SMS_CONFIGURED=false
SMS_DOCUMENTATION_VERIFIED=false
SMS_PROVIDER_NAME=
SMS_DOCUMENTATION_URL=
SMS_DOCUMENTATION_VERSION=
SMS_SUPPORTS_IDEMPOTENCY=false
SMS_IDEMPOTENCY_HEADER=Idempotency-Key
NOTIFICATION_CONTENT_RETENTION_DAYS=30
NOTIFICATION_ATTEMPT_RETENTION_DAYS=180
ENGAGEMENT_TEST_RECIPIENT_ALIASES={}

META_CAPI_MODE=disabled
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
GOOGLE_ANALYTICS_ID=
ASSISTANT_PROVIDER=disabled
ASSISTANT_ENDPOINT=https://api.openai.com/v1/chat/completions
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4.1-mini
ASSISTANT_PUBLIC_ENABLED=false
ASSISTANT_ZERO_RETENTION_APPROVED=false
ASSISTANT_DPA_APPROVED=false
NEWSLETTER_ENABLED=true
WHATSAPP_ENABLED=false
WHATSAPP_PHONE=+8801700000000

REVALIDATION_URL=http://frontend:3000/api/revalidate
REVALIDATION_SECRET=local-only-change-me-revalidation-secret
WORKER_HEARTBEAT_KEY=bojro:worker:heartbeat
WORKER_HEARTBEAT_MAX_AGE_SECONDS=180
WORKER_HEARTBEAT_REQUIRED=false
RETENTION_CLEANUP_BATCH_SIZE=500

# Test-only capabilities are deliberately off. Enable all required values explicitly at the CLI.
NEXT_PUBLIC_E2E_STORAGE_MOCK=0
NEXT_PUBLIC_E2E_PROVIDER_MOCK=0
NEXT_PUBLIC_E2E_ENGAGEMENT_MOCK=0
PHASE6_E2E_RESET_TOKEN=
PHASE7_E2E_ENABLED=false
PHASE7_E2E_RESET_TOKEN=

# Optional local admin seed. Never set SEED_ADMIN_* in staging or production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
